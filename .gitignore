# Terraform working directory
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files with secrets
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config files
.terraformrc
terraform.rc

# Plan output files
*.tfplan
plan.out

# Dependency lock file
# Usually SHOULD be committed, so do NOT ignore it:
# .terraform.lock.hcl

# macOS
.DS_Store
**/.DS_Store

# Windows
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/
*.swp
*.swo